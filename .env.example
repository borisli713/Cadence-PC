# Optional Google Desktop App OAuth Client credentials for direct accounts.google.com sign-in
# (Create a "Desktop app" OAuth Client ID in Google Cloud Console for project silken-eye-377716
#  and add its Client ID to Firebase Auth -> Sign-in method -> Google -> Whitelist client IDs)
CADENCE_GOOGLE_DESKTOP_CLIENT_ID=
CADENCE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional GitHub repository slug override for update checks (defaults to borisli713/Cadence-PC)
CADENCE_GITHUB_REPO=borisli713/Cadence-PC
VITE_GITHUB_REPO=borisli713/Cadence-PC
