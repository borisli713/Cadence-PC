        "reviewNote": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shiftId",
        "shiftTitle",
        "requesterUid",
        "requesterName",
        "type",
        "currentDate",
        "currentStartTime",
        "currentEndTime",
        "proposedDate",
        "proposedStartTime",
        "proposedEndTime",
        "proposedAssigneeUid",
        "proposedAssigneeName",
        "reason",
        "status",
        "reviewedByUid",
        "reviewedByName",
        "reviewNote",
        "createdAt",
        "updatedAt"
      ]
    },
