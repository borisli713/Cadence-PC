{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user account profile containing PII such as email and notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["staff", "manager"]
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "weeklyHoursTarget": {
          "type": "number"
        },
        "pushNotificationsEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "department",
        "weeklyHoursTarget",
        "pushNotificationsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffDirectoryEntry": {
      "title": "StaffDirectoryEntry",
      "description": "Non-PII operational staff roster entry tracking cumulative working hours for fairness scheduling.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["staff", "manager"]
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "totalHoursWorked": {
          "type": "number"
        },
        "scheduledHoursThisWeek": {
          "type": "number"
        },
        "weeklyHoursTarget": {
          "type": "number"
        },
        "lastAssignedAt": {
          "type": "string",
          "maxLength": 40
        },
        "isSampleRoster": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "department",
        "totalHoursWorked",
        "scheduledHoursThisWeek",
        "weeklyHoursTarget",
        "lastAssignedAt",
        "isSampleRoster",
        "updatedAt"
      ]
    },
    "ManagerRecord": {
      "title": "ManagerRecord",
      "description": "Trusted role lookup record granting manager permissions.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Scheduled or open/blank workplace shift with candidate tracking for fairness-based overlap resolution.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "durationHours": {
          "type": "number"
        },
        "assignedUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$"
        },
        "assignedName": {
          "type": "string",
          "maxLength": 80
        },
        "candidateUids": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "open", "completed", "conflict", "pending_change"]
        },
        "visibility": {
          "type": "string",
          "enum": ["team"]
        },
        "fairnessNote": {
          "type": "string",
          "maxLength": 300
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "department",
        "date",
        "startTime",
        "endTime",
        "durationHours",
        "assignedUid",
        "assignedName",
        "candidateUids",
        "status",
        "visibility",
        "fairnessNote",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
