  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user account documents containing PII."
    },
    "/staffDirectory/{userId}": {
      "schema": { "$ref": "#/entities/StaffDirectoryEntry" },
      "description": "Non-PII operational staff roster with cumulative hours for fairness scheduling."
    },
    "/managers/{userId}": {
      "schema": { "$ref": "#/entities/ManagerRecord" },
      "description": "Authoritative lookup documents for manager role privileges."
    },
    "/shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/Shift" },
      "description": "Scheduled or open/blank workplace shifts and overlap candidate lists."
    },
    "/scheduleChanges/{changeId}": {
      "schema": { "$ref": "#/entities/ScheduleChangeRequest" },
      "description": "Pending and resolved schedule change requests."
    },
    "/shiftReports/{reportId}": {
      "schema": { "$ref": "#/entities/ShiftReport" },
      "description": "Staff shift completion and handoff reports."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/PushNotification" },
      "description": "Real-time shift status update notifications for staff."
    },
    "/shiftSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ShiftSubmission" },
      "description": "Explicit shift submissions by staff for fairness-based scheduling."
    },
    "/timeOffRequests/{requestId}": {
      "schema": { "$ref": "#/entities/TimeOffRequest" },
      "description": "Staff time off requests with manager approval workflow."
    }
  }
}
