{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "1.1.0",
  "identifier": "com.cadence.shifts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cadence — Shift Reporting & Fair Scheduling",
        "width": 1360,
        "height": 860,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "allowDowngrades": true,
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "headerImage": "windows/nsis-header.bmp",
        "uninstallerHeaderImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "4311d0a4-d8fc-5c86-a5a3-9d72fc38e1d8",
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    }
  }
}
